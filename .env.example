# Keep .env and .env.local private. Docker Compose reads .env; Next.js reads .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=merit_track
DB_USER=merittrack
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA=

# Local is the development default. Use onedrive only after Microsoft Graph is configured.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SITE_ID=
MICROSOFT_DRIVE_ID=
MICROSOFT_STORAGE_ROOT=MeritTrack/evidence

# Email Provider: 'smtp' (cho môi trường chạy thật với mail tổ chức) hoặc 'console' (để test ghi log màn hình)
EMAIL_PROVIDER=smtp

# Cấu hình Mail tổ chức qua giao thức SMTP (cPanel Mail, Google Workspace, Gmail, Microsoft 365, v.v.)
SMTP_HOST=mail.tuoitrefetiuh.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thidua@tuoitrefetiuh.com
SMTP_PASS=MatKhauEmailCuaToChuc
# Bỏ qua lỗi SSL nếu mail server nội bộ dùng chứng chỉ tự ký (mặc định là false)
SMTP_REJECT_UNAUTHORIZED=true

# Tên & Email hiển thị khi sinh viên nhận mã xác nhận
EMAIL_FROM="Hệ thống Thi đua - Khen thưởng FET <thidua@tuoitrefetiuh.com>"

# Khóa bí mật tạo token xác thực quên mật khẩu (ít nhất 32 ký tự ngẫu nhiên)
PASSWORD_RESET_SECRET=thay_the_bang_chuoi_bi_mat_ngau_nhien_it_nhat_32_ky_tu
