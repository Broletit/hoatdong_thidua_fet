# Keep .env and .env.local private. Docker Compose reads .env; Next.js reads .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=merit_track
DB_USER=merittrack
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA=

# Cấu hình Lưu trữ: 'onedrive' (để lưu toàn bộ minh chứng trên Microsoft OneDrive) hoặc 'local' (lưu tại thư mục storage trên server)
STORAGE_PROVIDER=onedrive

# Đường dẫn thư mục gốc trên OneDrive
MICROSOFT_STORAGE_ROOT=thiduafet/evidence

# Thông tin Azure App Registration (Microsoft Entra ID) cấp quyền lưu trữ OneDrive
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# (Tùy chọn) Điền 1 trong các mục sau nếu bạn muốn chỉ định cụ thể:
# - MICROSOFT_DRIVE_ID: ID của Drive cụ thể (nếu để trống hệ thống sẽ tự tìm Drive mặc định)
# - MICROSOFT_USER_EMAIL: Email tài khoản OneDrive tổ chức (ví dụ: admin@tuoitrefetiuh.com)
# - MICROSOFT_SITE_ID: SharePoint Site ID (nếu dùng thư viện tài liệu SharePoint)
MICROSOFT_DRIVE_ID=
MICROSOFT_USER_EMAIL=
MICROSOFT_SITE_ID=

# Nếu dùng lưu trữ cục bộ (local):
LOCAL_STORAGE_ROOT=storage

# Email Provider: 'resend' (gửi mã xác nhận quên mật khẩu qua Resend API nhanh, tin cậy, không lo bị chặn port máy chủ) hoặc 'console' (để test ghi log)
EMAIL_PROVIDER=resend

# Cấu hình Resend API (Lấy API Key tại https://resend.com/api-keys):
RESEND_API_KEY=re_your_api_key_here

# Tên & Email gửi đi (phải thuộc tên miền đã xác thực trên Resend, ví dụ: tuoitrefetiuh.com):
EMAIL_FROM="IUH <noreply@tuoitrefetiuh.com>"

# Giới hạn số lượng email tối đa mỗi ngày cho toàn hệ thống (mặc định 80)
DAILY_EMAIL_LIMIT=80

# Khóa bí mật tạo token xác thực quên mật khẩu (ít nhất 32 ký tự ngẫu nhiên)
PASSWORD_RESET_SECRET=thay_the_bang_chuoi_bi_mat_ngau_nhien_it_nhat_32_ky_tu

# Chế độ bảo trì hệ thống:
# - 'true': Bật bảo trì (tự động chuyển hướng toàn bộ người dùng sang trang /maintenance, API trả về 503)
# - 'false': Tắt bảo trì (hệ thống hoạt động bình thường)
MAINTENANCE_MODE=false
